# Copy to server/.env for local development. Never commit the real file:
# .gitignore already excludes it, and the live credentials belong only in
# Render's environment variables.

# Neon connection string, from the Neon dashboard.
# Locally you can point this at any Postgres:
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/poker?sslmode=disable

# The GitHub Pages address the browser loads the site from, no trailing
# slash. Several may be listed, comma separated.
ALLOWED_ORIGIN=http://127.0.0.1:5500

# Optional. Defaults shown.
# HEARTBEAT_SECONDS=120
# IDLE_TIMEOUT_SECONDS=600
# ALLOW_MISSING_ORIGIN=1
